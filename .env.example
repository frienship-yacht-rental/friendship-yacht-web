# Copy to `.env.local` and fill in. Validated by `src/env.ts` at build time —
# a missing or malformed value fails the build rather than the first request.

# --- Server-only (never sent to the browser) ---------------------------------

# Base URL of friendship-yacht-api, as reachable from the Next.js server.
API_BASE_URL="http://localhost:8000"

# Bearer token for authenticated server-to-server calls. Optional until the
# API requires auth.
# API_TOKEN=""

# Shared secret for on-demand revalidation webhooks (min 16 chars).
# REVALIDATE_SECRET=""

# --- Public (inlined into the client bundle — never put secrets here) ---------

# Canonical public origin. Used for metadata, canonical URLs, sitemap, robots.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# API origin reachable from the browser, for client-side queries.
NEXT_PUBLIC_API_URL="http://localhost:8000"
